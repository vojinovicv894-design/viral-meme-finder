# Server Configuration
PORT=5000
NODE_ENV=development

# YouTube API
YOUTUBE_API_KEY=your_youtube_api_key_here

# TikTok API
TIKTOK_API_KEY=your_tiktok_api_key_here
TIKTOK_API_URL=https://api.tiktok.com/v1

# Vine Archive API (if available)
VINE_API_URL=https://vine.co/api

# App Configuration
MAX_RESULTS=20
VIDEO_CACHE_TIME=3600
